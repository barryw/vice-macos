{"abstract":[{"text":"Embed VICE machines in native macOS apps.","type":"text"}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc://macvicekit.MacVICEKit/documentation/MacVICEKit"},"kind":"symbol","metadata":{"externalID":"MacVICEKit","modules":[{"name":"MacVICEKit"}],"platforms":[{"beta":false,"introducedAt":"13.0","name":"macOS"}],"role":"collection","roleHeading":"Framework","symbolKind":"module","title":"MacVICEKit"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"MacVICEKit is the Swift package behind mac VICE. It wraps the native VICE core","type":"text"},{"text":" ","type":"text"},{"text":"with APIs for starting emulator sessions, embedding a Metal display, forwarding","type":"text"},{"text":" ","type":"text"},{"text":"Mac input, attaching media, observing emulator callbacks, and building debugger","type":"text"},{"text":" ","type":"text"},{"text":"or inspection tools.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use the release SDK zip for app integrations. The SDK includes the Swift","type":"text"},{"text":" ","type":"text"},{"text":"package, the C bridge, and the matching ","type":"text"},{"code":"MacVICERuntime.xcframework","type":"codeVoice"},{"text":" artifact.","type":"text"}],"type":"paragraph"},{"code":["import SwiftUI","import MacVICEKit","","struct EmulatorView: View {","    @State private var session = MacVICEEngineSession(","        configuration: MacVICEMachineConfiguration(","            machine: .c64sc,","            runtimeLocation: .automatic","        )","    )","    @State private var didStart = false","","    var body: some View {","        MacVICEDisplayView(session: session)","            .frame(minWidth: 768, minHeight: 544)","            .task {","                guard !didStart else {","                    return","                }","                didStart = true","","                do {","                    try session.start()","                } catch {","                    assertionFailure(error.localizedDescription)","                    return","                }","","                session.typeText(\"10 PRINT \\\"HELLO FROM MACVICEKIT\\\"\\n20 GOTO 10\\nRUN\\n\")","            }","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Runtime-Packaging","level":2,"text":"Runtime Packaging","type":"heading"},{"inlineContent":[{"text":"MacVICEKit does not build VICE during Swift package resolution. Apps should use","type":"text"},{"text":" ","type":"text"},{"text":"the release SDK or provide a prepared runtime directory. With","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://macvicekit.MacVICEKit/documentation/MacVICEKit/MacVICERuntimeLocation/automatic","isActive":true,"type":"reference"},{"text":", runtime lookup checks ","type":"text"},{"code":"MACVICE_RUNTIME_DIR","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"embedded framework layouts, app bundle ","type":"text"},{"code":"Frameworks","type":"codeVoice"},{"text":", and local mac VICE checkout","type":"text"},{"text":" ","type":"text"},{"text":"builds.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The runtime must contain the machine-specific ","type":"text"},{"code":"libvicemac*.dylib","type":"codeVoice"},{"text":" files and the","type":"text"},{"text":" ","type":"text"},{"text":"VICE data directory with ROMs, keymaps, palettes, and other runtime resources.","type":"text"}],"type":"paragraph"},{"anchor":"Session-Flow","level":2,"text":"Session Flow","type":"heading"},{"inlineContent":[{"text":"Create a ","type":"text"},{"identifier":"doc://macvicekit.MacVICEKit/documentation/MacVICEKit/MacVICEMachineConfiguration","isActive":true,"type":"reference"},{"text":", create a ","type":"text"},{"identifier":"doc://macvicekit.MacVICEKit/documentation/MacVICEKit/MacVICEEngineSession","isActive":true,"type":"reference"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"call ","type":"text"},{"identifier":"doc://macvicekit.MacVICEKit/documentation/MacVICEKit/MacVICEEngineSession/start()","isActive":true,"type":"reference"},{"text":". Once the machine is running, use the","type":"text"},{"text":" ","type":"text"},{"text":"session to pause, reset, type text, attach media, read resources, capture","type":"text"},{"text":" ","type":"text"},{"text":"screenshots, or reach the monitor debugger through ","type":"text"},{"identifier":"doc://macvicekit.MacVICEKit/documentation/MacVICEKit/MacVICEEngineSession/debugger","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://macvicekit.MacVICEKit/documentation/MacVICEKit":{"abstract":[{"text":"Embed VICE machines in native macOS apps.","type":"text"}],"identifier":"doc://macvicekit.MacVICEKit/documentation/MacVICEKit","kind":"symbol","role":"collection","title":"MacVICEKit","type":"topic","url":"/documentation/macvicekit"},"doc://macvicekit.MacVICEKit/documentation/MacVICEKit/MacVICEAudioSampleSource":{"abstract":[{"text":"Thread-safe in-memory audio source populated by ","type":"text"},{"code":"MacVICEEngineSession","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MacVICEAudioSampleSource"}],"identifier":"doc://macvicekit.MacVICEKit/documentation/MacVICEKit/MacVICEAudioSampleSource","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MacVICEAudioSampleSource"}],"role":"symbol","title":"MacVICEAudioSampleSource","type":"topic","url":"/documentation/macvicekit/macviceaudiosamplesource"},"doc://macvicekit.MacVICEKit/documentation/MacVICEKit/MacVICEAudioSamples":{"abstract":[{"text":"Interleaved signed 16-bit audio samples emitted by the VICE engine.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","tex